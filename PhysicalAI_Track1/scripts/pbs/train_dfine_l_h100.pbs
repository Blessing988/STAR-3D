#!/bin/bash
#PBS -q gpus
#PBS -N Track1_DFINE_L
#PBS -l select=1:mem=260gb:ncpus=24:ngpus=1:host=gpu0061
#PBS -l walltime=168:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
DFINE_ROOT="${DFINE_ROOT:-$PROJECT_ROOT/D-FINE}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/dfine}"
CONFIG="${CONFIG:-$DFINE_ROOT/configs/dfine/custom/track1_dfine_hgnetv2_l_960_class_balanced.yml}"
RUN_NAME="${RUN_NAME:-dfine_l_960_class_balanced}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
RUN_DIR="${RUN_DIR:-$SCRATCH_ROOT/runs/dfine/$RUN_NAME}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/dfine}"
MASTER_PORT="${MASTER_PORT:-29631}"

mkdir -p "$RUN_DIR" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$DFINE_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"

echo "job_id=${PBS_JOBID:-unknown}"
echo "host=$(hostname)"
echo "config=$CONFIG"
echo "run_dir=$RUN_DIR"
date
nvidia-smi || true

python - <<'PY'
import torch
print("torch", torch.__version__)
print("cuda_available", torch.cuda.is_available())
print("device_count", torch.cuda.device_count())
if torch.cuda.is_available():
    print("gpu0", torch.cuda.get_device_name(0))
else:
    raise SystemExit("CUDA is not available in the D-FINE environment/job allocation")
PY

torchrun \
  --master_port="$MASTER_PORT" \
  --nproc_per_node=1 \
  train.py \
  -c "$CONFIG" \
  --use-amp \
  --seed=0 \
  --device cuda \
  --output-dir "$RUN_DIR"
