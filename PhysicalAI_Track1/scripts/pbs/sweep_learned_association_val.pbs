#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_LearnedAssoc_Val
#PBS -l select=1:mem=100gb:ncpus=16
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATA_ROOT="${DATA_ROOT:-/path/to/PhysicalAI-SmartSpaces}"
FUSED="${FUSED:-$SCRATCH_ROOT/runs/inference/yolo26x_star_val_692131.bright04/star/fused.tsv}"
ASSOCIATION_MODEL="${ASSOCIATION_MODEL:-$SCRATCH_ROOT/runs/association/assoc_logreg_train_stride1.json}"
RUN_NAME="${RUN_NAME:-learned_assoc_val_${PBS_JOBID:-manual}}"
RUN_DIR="${RUN_DIR:-$SCRATCH_ROOT/runs/sweeps/$RUN_NAME}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/sweeps}"
SCENES="${SCENES:-Warehouse_020 Warehouse_021 Warehouse_022}"
MAX_FRAMES="${MAX_FRAMES:-600}"
FRAME_STRIDE="${FRAME_STRIDE:-30}"
CLASS_MIN_SCORES="${CLASS_MIN_SCORES:-0:0.75,1:0.88,2:0.50,3:0.55,4:0.55,5:0.55,6:0.62}"

mkdir -p "$RUN_DIR" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

date
hostname
echo "fused=$FUSED"
echo "association_model=$ASSOCIATION_MODEL"
echo "run_dir=$RUN_DIR"

if [[ ! -s "$FUSED" ]]; then
  echo "Missing fused detections: $FUSED" >&2
  exit 2
fi
if [[ ! -s "$ASSOCIATION_MODEL" ]]; then
  echo "Missing association model: $ASSOCIATION_MODEL" >&2
  exit 3
fi

run_variant() {
  local name="$1"
  local association_weight="$2"
  local association_min_probability="$3"
  local max_cost="$4"
  local max_distance="$5"
  local max_age="$6"
  local out_dir="$RUN_DIR/$name"
  mkdir -p "$out_dir"

  echo "=== variant=$name association_weight=$association_weight min_probability=$association_min_probability"
  args=(
    python -m physicalai_track1 track-online
    --fused "$FUSED"
    --class-min-scores "$CLASS_MIN_SCORES"
    --min-score 0.0
    --max-cost "$max_cost"
    --max-distance-m "$max_distance"
    --max-age "$max_age"
    --distance-weight 1.0
    --iou-weight 0.35
    --yaw-weight 0.08
    --score-weight 0.18
    --source-weight 0.12
    --position-alpha 0.85
    --velocity-alpha 0.70
    --decimals 6
    --out "$out_dir/track1.txt"
  )
  if [[ "$association_weight" != "0.0" ]]; then
    args+=(
      --association-model "$ASSOCIATION_MODEL"
      --association-weight "$association_weight"
    )
    if [[ "$association_min_probability" != "none" ]]; then
      args+=(--association-min-probability "$association_min_probability")
    fi
  fi
  "${args[@]}" > "$out_dir/track.json"

  python -m physicalai_track1 eval \
    --data-root "$DATA_ROOT" \
    --year 2026 \
    --split val \
    --scenes $SCENES \
    --max-frames-per-scene "$MAX_FRAMES" \
    --frame-stride "$FRAME_STRIDE" \
    --by-class \
    --pred "$out_dir/track1.txt" > "$out_dir/eval.json"

  python -m physicalai_track1 validate --submission "$out_dir/track1.txt" > "$out_dir/validate.json"
  cat "$out_dir/eval.json"
}

run_variant "baseline_v2_like" "0.0" "none" "1.10" "1.60" "45"
run_variant "learned_w025" "0.25" "none" "1.10" "1.60" "45"
run_variant "learned_w050" "0.50" "none" "1.10" "1.60" "45"
run_variant "learned_w050_gate005" "0.50" "0.05" "1.10" "1.60" "45"
run_variant "learned_w075_gate010" "0.75" "0.10" "1.10" "1.60" "45"

date
