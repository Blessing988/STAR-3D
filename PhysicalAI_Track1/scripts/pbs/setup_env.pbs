#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_Setup_Baseline_Env
#PBS -l select=1:mem=120gb:ncpus=16
#PBS -l walltime=08:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1}"

cd "$PROJECT_ROOT"

source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base

if [ ! -d "$CONDA_ENV" ]; then
  conda create -p "$CONDA_ENV" -y python=3.10 pip numpy scipy pyyaml tqdm
else
  echo "Environment already exists: $CONDA_ENV"
fi

source activate "$CONDA_ENV"
python -m pip install --upgrade pip setuptools wheel
python -m pip install opencv-python-headless
python -m pip install -e "$PROJECT_ROOT"

python - <<'PY'
import sys
print("python", sys.version)
import numpy
import scipy
import yaml
import cv2
print("numpy", numpy.__version__)
print("scipy", scipy.__version__)
print("pyyaml", yaml.__version__)
print("opencv", cv2.__version__)
try:
    import torch
    print("torch", torch.__version__, "cuda", torch.cuda.is_available())
except Exception as exc:
    print("torch not installed in baseline env:", exc)
PY
