#!/bin/bash
#PBS -q gpus
#PBS -N Track1_DepthGeom_MLP
#PBS -l select=1:mem=100gb:ncpus=8:ngpus=1
#PBS -l walltime=168:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATASET="${DATASET:-$SCRATCH_ROOT/datasets/geometry_residual/depth_train_stride15.npz}"
OUT="${OUT:-$SCRATCH_ROOT/runs/geometry_residual/depth_geometry_mlp_stride15.npz}"
EPOCHS="${EPOCHS:-80}"
BATCH_SIZE="${BATCH_SIZE:-4096}"
PATIENCE="${PATIENCE:-12}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/geometry}"

mkdir -p "$(dirname "$OUT")" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

python -m physicalai_track1 train-geometry-residual \
  --dataset "$DATASET" \
  --epochs "$EPOCHS" \
  --batch-size "$BATCH_SIZE" \
  --patience "$PATIENCE" \
  --device cuda \
  --out "$OUT"
