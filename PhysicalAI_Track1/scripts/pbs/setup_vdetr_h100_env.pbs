#!/bin/bash
#PBS -q gpus
#PBS -N Track1_Setup_VDETR_H100
#PBS -l select=1:mem=160gb:ncpus=24:ngpus=1:glist=h100
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
ZIO_ROOT="${ZIO_ROOT:-$PROJECT_ROOT/external/AIC2025_Track1_ZV}"
VDETR_ROOT="${VDETR_ROOT:-$ZIO_ROOT/V-DETR}"
ENV_PREFIX="${ENV_PREFIX:-/path/to/conda_envs/vdetr_h100}"
LOG_DIR="${LOG_DIR:-/path/to/scratch/PhysicalAI_Track1/logs/vdetr}"
SCRATCH_CACHE="${SCRATCH_CACHE:-/path/to/scratch/PhysicalAI_Track1/cache/vdetr_h100_setup}"
CLEAN_ENV="${CLEAN_ENV:-0}"

mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

mkdir -p "$SCRATCH_CACHE"/{tmp,pip,torch,conda_pkgs,build}
export TMPDIR="$SCRATCH_CACHE/tmp"
export TEMP="$SCRATCH_CACHE/tmp"
export TMP="$SCRATCH_CACHE/tmp"
export PIP_CACHE_DIR="$SCRATCH_CACHE/pip"
export TORCH_HOME="$SCRATCH_CACHE/torch"
export CONDA_PKGS_DIRS="$SCRATCH_CACHE/conda_pkgs"
export MAX_JOBS="${MAX_JOBS:-8}"
export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-9.0}"
export TORCH_NVCC_FLAGS="${TORCH_NVCC_FLAGS:---use_fast_math}"
export TORCH_DONT_CHECK_COMPILER_ABI=1

cd "$PROJECT_ROOT"
module unload gcc/15.2.0 || true
module load gcc/11.2.0 || true
module load cuda/12.3 || module load cuda/12.1 || true

if command -v nvcc >/dev/null 2>&1; then
  export CUDA_HOME="$(dirname "$(dirname "$(command -v nvcc)")")"
  export CUDA_PATH="$CUDA_HOME"
  export PATH="$CUDA_HOME/bin:$PATH"
  export LD_LIBRARY_PATH="$CUDA_HOME/lib64:${LD_LIBRARY_PATH:-}"
fi

echo "hostname=$(hostname)"
echo "ENV_PREFIX=$ENV_PREFIX"
echo "CUDA_HOME=${CUDA_HOME:-unset}"
echo "TORCH_CUDA_ARCH_LIST=$TORCH_CUDA_ARCH_LIST"
nvcc --version || true
nvidia-smi || true

source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base

if [[ "$CLEAN_ENV" == "1" && -d "$ENV_PREFIX" ]]; then
  conda env remove -y -p "$ENV_PREFIX" || true
  rm -rf "$ENV_PREFIX"
fi

if [[ ! -d "$ENV_PREFIX" ]]; then
  conda create -y -p "$ENV_PREFIX" python=3.10
fi
set +u
source activate "$ENV_PREFIX"
set -u

conda install -y -c conda-forge openblas openblas-devel

python -m pip install --upgrade pip setuptools wheel ninja packaging
python -m pip install --index-url https://download.pytorch.org/whl/cu121 \
  torch==2.4.1 torchvision==0.19.1 torchaudio==2.4.1

python -m pip install \
  numpy==1.26.4 \
  scipy \
  scikit-learn \
  pyyaml \
  cython \
  timm \
  wandb \
  trimesh==2.35.39 \
  matplotlib \
  pluggy==1.0.0 \
  plyfile==0.7.4 \
  protobuf==4.25.2 \
  shapely \
  h5py \
  opencv-python-headless \
  openmim

# V-DETR needs compiled mmcv.ops, not mmcv-lite.
python -m pip uninstall -y mmcv mmcv-lite || true
python -m pip install -U openmim
mim install "mmcv==2.2.0" || mim install "mmcv==2.1.0"

export CC="$(command -v gcc)"
export CXX="$(command -v g++)"
export CUDAHOSTCXX="$CXX"
echo "CC=$CC"
echo "CXX=$CXX"
"$CC" --version | head -1 || true
"$CXX" --version | head -1 || true

cd "$ZIO_ROOT/MinkowskiEngine"
if ! grep -q "thrust/execution_policy.h" src/3rdparty/concurrent_unordered_map.cuh; then
  python - <<'PY'
from pathlib import Path
path = Path("src/3rdparty/concurrent_unordered_map.cuh")
text = path.read_text()
needle = "#include <thrust/count.h>\n"
path.write_text(text.replace(needle, needle + "#include <thrust/execution_policy.h>\n", 1))
PY
fi
python - <<'PY'
from pathlib import Path
patches = {
    Path("src/coordinate_map_gpu.cu"): [
        "#include <thrust/remove.h>\n",
        "#include <thrust/unique.h>\n",
    ],
}
for path, includes in patches.items():
    text = path.read_text()
    insert_after = "#include <thrust/sort.h>\n"
    if insert_after not in text:
        insert_after = "#include <thrust/functional.h>\n"
    addition = "".join(line for line in includes if line not in text)
    if addition:
        text = text.replace(insert_after, insert_after + addition, 1)
        path.write_text(text)
PY
python setup.py clean --all || true
rm -rf build dist *.egg-info
python -m pip uninstall -y MinkowskiEngine || true
python -m pip cache purge || true
export CPATH="${CONDA_PREFIX}/include:${CPATH:-}"
export C_INCLUDE_PATH="${CONDA_PREFIX}/include:${C_INCLUDE_PATH:-}"
export CPLUS_INCLUDE_PATH="${CONDA_PREFIX}/include:${CPLUS_INCLUDE_PATH:-}"
export LIBRARY_PATH="${CONDA_PREFIX}/lib:${LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
python setup.py install --blas=openblas --force_cuda

cd "$VDETR_ROOT/third_party/pointnet2"
python setup.py clean --all || true
rm -rf build dist *.egg-info
python setup.py install

cd "$VDETR_ROOT/utils"
python cython_compile.py build_ext --inplace

cd "$VDETR_ROOT"
python - <<'PY'
import importlib.util
mods = ["torch", "MinkowskiEngine", "mmcv", "plyfile", "pointnet2", "yaml", "scipy", "sklearn"]
for mod in mods:
    print(f"{mod}={bool(importlib.util.find_spec(mod))}")
import torch
print("torch", torch.__version__, torch.version.cuda, torch.cuda.is_available())
import numpy as np
print("numpy", np.__version__)
import mmcv
print("mmcv", mmcv.__version__)
import mmcv._ext
from mmcv.ops import points_in_boxes_all, furthest_point_sample
print("mmcv_ops_ok")
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0), torch.cuda.get_device_capability(0))
    import MinkowskiEngine as ME
    coords = torch.IntTensor([[0, 0, 0, 0], [0, 1, 1, 1]]).cuda()
    feats = torch.randn(2, 3, device="cuda")
    st = ME.SparseTensor(features=feats, coordinates=coords)
    print("minkowski_sparse_tensor", st.F.shape, st.C.shape)
    conv = ME.MinkowskiConvolution(3, 4, kernel_size=3, dimension=3).cuda()
    out = conv(st)
    torch.cuda.synchronize()
    print("minkowski_conv_ok", out.F.shape, out.C.shape)
PY
