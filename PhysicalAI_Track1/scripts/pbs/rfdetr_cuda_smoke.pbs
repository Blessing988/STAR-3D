#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_RFDETR_CUDA_Smoke
#PBS -l select=1:mem=32gb:ncpus=4:ngpus=1:glist=h100:host=gpu0063
#PBS -l walltime=00:10:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -j oe

set -euo pipefail

cd /path/to/PhysicalAI_Track1
source activate /path/to/conda_envs/rfdetr

python - <<'PY'
import torch
print("torch", torch.__version__, "cuda_build", torch.version.cuda, flush=True)
print("cuda_available", torch.cuda.is_available(), flush=True)
print("device_count", torch.cuda.device_count(), flush=True)
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0), flush=True)
    x = torch.randn(1024, 1024, device="cuda")
    y = x @ x
    torch.cuda.synchronize()
    print("cuda_op_ok", float(y[0, 0].detach().cpu()), flush=True)
PY
