#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_OnlineBirth_Val
#PBS -l select=1:mem=80gb:ncpus=8
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATA_ROOT="${DATA_ROOT:-/path/to/PhysicalAI-SmartSpaces}"
FUSED="${FUSED:-$SCRATCH_ROOT/runs/inference/ensemble_yolo_dfine_val_692702.bright04/star/fused.tsv}"
RUN_ROOT="${RUN_ROOT:-$SCRATCH_ROOT/runs/sweeps/online_birth_control_val_${PBS_JOBID:-manual}}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/sweeps}"
SCENES="${SCENES:-Warehouse_020 Warehouse_021 Warehouse_022}"
MAX_FRAMES="${MAX_FRAMES:-600}"
FRAME_STRIDE="${FRAME_STRIDE:-30}"
export RUN_ROOT

mkdir -p "$RUN_ROOT" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

date
hostname
echo "fused=$FUSED"
echo "run_root=$RUN_ROOT"

if [[ ! -s "$FUSED" ]]; then
  echo "Missing fused detections: $FUSED" >&2
  exit 2
fi

run_variant() {
  local name="$1"
  local class_scores="$2"
  local max_cost="$3"
  local max_distance="$4"
  local max_age="$5"
  local class_distances="$6"
  local class_costs="$7"
  local class_ages="$8"
  local confirmation_hits="$9"
  local confirmation_mode="${10}"
  local class_confirmation_hits="${11}"
  local duplicate_distance="${12}"
  local class_duplicate_distances="${13}"
  local duplicate_iou="${14}"
  local out_dir="$RUN_ROOT/$name"

  mkdir -p "$out_dir"
  echo "=== variant=$name"
  echo "class_scores=$class_scores"
  echo "max_cost=$max_cost max_distance=$max_distance max_age=$max_age"
  echo "class_distances=$class_distances"
  echo "class_costs=$class_costs"
  echo "class_ages=$class_ages"
  echo "confirmation_hits=$confirmation_hits confirmation_mode=$confirmation_mode"
  echo "class_confirmation_hits=$class_confirmation_hits"
  echo "duplicate_distance=$duplicate_distance class_duplicate_distances=$class_duplicate_distances duplicate_iou=$duplicate_iou"

  args=(python -m physicalai_track1 track-online
    --fused "$FUSED"
    --class-min-scores "$class_scores"
    --min-score 0.0
    --max-cost "$max_cost"
    --max-distance-m "$max_distance"
    --max-age "$max_age"
    --class-max-distances-m "$class_distances"
    --class-max-costs "$class_costs"
    --class-max-ages "$class_ages"
    --distance-weight 1.0
    --iou-weight 0.35
    --yaw-weight 0.08
    --score-weight 0.18
    --source-weight 0.12
    --position-alpha 0.85
    --velocity-alpha 0.70
    --confirmation-hits "$confirmation_hits"
    --confirmation-mode "$confirmation_mode"
    --duplicate-birth-distance-m "$duplicate_distance"
    --duplicate-birth-iou "$duplicate_iou"
    --decimals 6
    --out "$out_dir/track1.txt")
  if [[ -n "$class_confirmation_hits" && "$class_confirmation_hits" != "none" ]]; then
    args+=(--class-confirmation-hits "$class_confirmation_hits")
  fi
  if [[ -n "$class_duplicate_distances" && "$class_duplicate_distances" != "none" ]]; then
    args+=(--class-duplicate-birth-distances-m "$class_duplicate_distances")
  fi
  "${args[@]}" > "$out_dir/track.json"

  python -m physicalai_track1 validate --submission "$out_dir/track1.txt" > "$out_dir/validate.json"
  python -m physicalai_track1 eval \
    --data-root "$DATA_ROOT" \
    --year 2026 \
    --split val \
    --scenes $SCENES \
    --max-frames-per-scene "$MAX_FRAMES" \
    --frame-stride "$FRAME_STRIDE" \
    --pred "$out_dir/track1.txt" > "$out_dir/eval.json"

  echo "line_count=$(wc -l < "$out_dir/track1.txt")"
  echo "object_count=$(cut -d' ' -f1,2,3 "$out_dir/track1.txt" | sort -u | wc -l)"
  cat "$out_dir/eval.json"
}

CLASS_SCORES="0:0.75,1:0.88,2:0.50,3:0.55,4:0.55,5:0.55,6:0.62"
CLASS_DISTANCES="0:1.45,1:2.35,2:2.00,3:2.40,4:2.10,5:1.85,6:2.30"
CLASS_COSTS="0:1.05,1:1.22,2:1.15,3:1.22,4:1.18,5:1.12,6:1.20"
CLASS_AGES="0:45,1:75,2:65,3:75,4:65,5:55,6:70"
DUP_DISTANCES="0:0.45,1:0.90,2:0.75,3:0.90,4:0.75,5:0.65,6:0.85"

run_variant "birth_base_immediate" "$CLASS_SCORES" "1.10" "1.60" "45" "$CLASS_DISTANCES" "$CLASS_COSTS" "$CLASS_AGES" "1" "immediate" "none" "0.0" "none" "0.0"
run_variant "birth_duplicate_only" "$CLASS_SCORES" "1.10" "1.60" "45" "$CLASS_DISTANCES" "$CLASS_COSTS" "$CLASS_AGES" "1" "immediate" "none" "0.0" "$DUP_DISTANCES" "0.05"
run_variant "birth_person_confirmed_only" "$CLASS_SCORES" "1.10" "1.60" "45" "$CLASS_DISTANCES" "$CLASS_COSTS" "$CLASS_AGES" "1" "confirmed_only" "0:2" "0.0" "$DUP_DISTANCES" "0.05"
run_variant "birth_person_backfill" "$CLASS_SCORES" "1.10" "1.60" "45" "$CLASS_DISTANCES" "$CLASS_COSTS" "$CLASS_AGES" "1" "backfill" "0:2" "0.0" "$DUP_DISTANCES" "0.05"
run_variant "birth_all_confirmed_only" "$CLASS_SCORES" "1.10" "1.60" "45" "$CLASS_DISTANCES" "$CLASS_COSTS" "$CLASS_AGES" "2" "confirmed_only" "none" "0.0" "$DUP_DISTANCES" "0.05"

python - <<'PY'
import json
import os
from pathlib import Path

root = Path(os.environ["RUN_ROOT"])
rows = []
for path in sorted(root.glob("*/eval.json")):
    with path.open("r", encoding="utf-8") as f:
        metrics = json.load(f)
    rows.append((metrics.get("hota_like", 0.0), path.parent.name, metrics))
for score, name, metrics in sorted(rows, reverse=True):
    print(
        f"{name}\thota_like={metrics.get('hota_like', 0.0):.6f}"
        f"\tdeta={metrics.get('deta', 0.0):.6f}"
        f"\tassa={metrics.get('assa', 0.0):.6f}"
        f"\tloca={metrics.get('loca', 0.0):.6f}"
    )
PY

date
