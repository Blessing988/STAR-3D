#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_VDETR_RareSubset
#PBS -l select=1:mem=64gb:ncpus=8
#PBS -l walltime=04:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
SRC_ROOT="${SRC_ROOT:-/path/to/scratch/PhysicalAI_Track1/datasets/zio_pcd_2026_slice20_stride100}"
OUT_ROOT="${OUT_ROOT:-/path/to/scratch/PhysicalAI_Track1/datasets/zio_pcd_2026_slice20_stride100_rarebalanced24k}"
MAX_COMMON="${MAX_COMMON:-12000}"
MAX_TOTAL="${MAX_TOTAL:-24000}"
MODE="${MODE:-symlink}"
LOG_DIR="${LOG_DIR:-/path/to/scratch/PhysicalAI_Track1/logs/vdetr}"

mkdir -p "$OUT_ROOT" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base
cd "$PROJECT_ROOT"

python scripts/build_vdetr_rare_subset.py \
  --src-root "$SRC_ROOT" \
  --out-root "$OUT_ROOT" \
  --max-common "$MAX_COMMON" \
  --max-total "$MAX_TOTAL" \
  --mode "$MODE"

find "$OUT_ROOT" -maxdepth 3 -type l -o -type f | wc -l
