#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_VDETR_WatchEval
#PBS -l select=1:mem=8gb:ncpus=1
#PBS -l walltime=48:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONFIG="${CONFIG:?CONFIG is required}"
DATASET_ROOT="${DATASET_ROOT:?DATASET_ROOT is required}"
RUN_DIR="${RUN_DIR:?RUN_DIR is required}"
RUN_TAG="${RUN_TAG:?RUN_TAG is required}"
CHECKPOINT="${CHECKPOINT:-$RUN_DIR/checkpoint_0001.pth}"
CONF="${CONF:-0.05}"
NUM_WORKERS="${NUM_WORKERS:-8}"
LOG_DIR="${LOG_DIR:-/path/to/scratch/PhysicalAI_Track1/logs/vdetr}"
SLEEP_SECONDS="${SLEEP_SECONDS:-300}"

mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
echo "watch_checkpoint=$CHECKPOINT"
echo "run_tag=$RUN_TAG"
date

while [[ ! -s "$CHECKPOINT" ]]; do
  echo "waiting for $CHECKPOINT"
  date
  sleep "$SLEEP_SECONDS"
done

echo "found checkpoint"
ls -lh "$CHECKPOINT"

EVAL_JOB=$(qsub -q gpus -l select=1:mem=160gb:ncpus=16:ngpus=1:glist=a40 \
  -v CONFIG="$CONFIG",DATASET_ROOT="$DATASET_ROOT",CHECKPOINT="$CHECKPOINT",OUT_DIR="/path/to/scratch/PhysicalAI_Track1/runs/vdetr_eval/${RUN_TAG}_epoch0001",NUM_WORKERS="$NUM_WORKERS" \
  scripts/pbs/eval_vdetr_aicity2026.pbs)
echo "EVAL_JOB=$EVAL_JOB"

EXPORT_JOB=$(qsub -q gpus -l select=1:mem=160gb:ncpus=16:ngpus=1:glist=a40 \
  -v CONFIG="$CONFIG",DATASET_ROOT="$DATASET_ROOT",CHECKPOINT="$CHECKPOINT",OUT_TSV="/path/to/scratch/PhysicalAI_Track1/runs/vdetr_export/${RUN_TAG}_epoch0001_val_slices.tsv",CONF="$CONF",NUM_WORKERS="$NUM_WORKERS" \
  scripts/pbs/export_vdetr_slice_predictions.pbs)
echo "EXPORT_JOB=$EXPORT_JOB"
