#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_DepthPro_Balance
#PBS -l select=1:mem=80gb:ncpus=8
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
SRC_ROOT="${SRC_ROOT:-/path/to/scratch/PhysicalAI_Track1/depth_estimates/zio_pcd_depthpro_trainval_stride30_sliced}"
TRAIN_SLICED_ROOT="${TRAIN_SLICED_ROOT:-/path/to/scratch/PhysicalAI_Track1/depth_estimates/zio_pcd_depthpro_train_stride30_sliced}"
VAL_SLICED_ROOT="${VAL_SLICED_ROOT:-/path/to/scratch/PhysicalAI_Track1/depth_estimates/zio_pcd_depthpro_val_stride30_sliced}"
OUT_ROOT="${OUT_ROOT:-/path/to/scratch/PhysicalAI_Track1/depth_estimates/zio_pcd_depthpro_trainval_stride30_balanced60k}"
ENV_PREFIX="${ENV_PREFIX:-/path/to/conda_envs/vdetr_aic2026}"
LOG_DIR="${LOG_DIR:-/path/to/scratch/PhysicalAI_Track1/logs/depth_pro}"

mkdir -p "$LOG_DIR" "$OUT_ROOT"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base
set +u
source activate "$ENV_PREFIX"
set -u

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src:$PROJECT_ROOT/scripts:${PYTHONPATH:-}"

mkdir -p "$SRC_ROOT"
ln -sfn "$TRAIN_SLICED_ROOT/train" "$SRC_ROOT/train"
ln -sfn "$VAL_SLICED_ROOT/val" "$SRC_ROOT/val"

python scripts/build_vdetr_balanced_subset.py \
  --src-root "$SRC_ROOT" \
  --out-root "$OUT_ROOT" \
  --max-train "${MAX_TRAIN:-60000}" \
  --max-person-only "${MAX_PERSON_ONLY:-12000}" \
  --class-weights ${CLASS_WEIGHTS:-0:1 1:2 2:8 3:6 4:8 5:8 6:4}

echo "Counts"
find "$OUT_ROOT/train/pcd" \( -type l -o -type f \) | wc -l
find "$OUT_ROOT/train/gt" \( -type l -o -type f \) | wc -l
find "$OUT_ROOT/val/pcd" \( -type l -o -type f \) | wc -l
find "$OUT_ROOT/val/gt" \( -type l -o -type f \) | wc -l
