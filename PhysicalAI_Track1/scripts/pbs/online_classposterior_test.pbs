#!/bin/bash
#PBS -q gpus
#PBS -N Track1_ClassPost_Test
#PBS -l select=1:mem=120gb:ncpus=16:ngpus=1
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
SOURCE_RUN="${SOURCE_RUN:-test_yolo40e_dfine_precision025_adaptive_score090}"
FUSED="${FUSED:-$SCRATCH_ROOT/runs/submissions/$SOURCE_RUN/star/fused.tsv}"
RUN_DIR="${RUN_DIR:-$SCRATCH_ROOT/runs/submissions/test_yolo40e_dfine_p025_classposterior_online}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/submissions}"

mkdir -p "$RUN_DIR" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

date
hostname
echo "fused=$FUSED"
echo "run_dir=$RUN_DIR"

python -m physicalai_track1 track-online \
  --fused "$FUSED" \
  --class-min-scores "0:0.75,1:0.88,2:0.50,3:0.55,4:0.55,5:0.55,6:0.62" \
  --min-score 0.0 \
  --max-cost 1.10 \
  --max-distance-m 1.60 \
  --max-age 45 \
  --class-max-distances-m "0:1.45,1:2.35,2:2.00,3:2.40,4:2.10,5:1.85,6:2.30" \
  --class-max-costs "0:1.05,1:1.22,2:1.15,3:1.22,4:1.18,5:1.12,6:1.20" \
  --class-max-ages "0:45,1:75,2:65,3:75,4:65,5:55,6:70" \
  --distance-weight 1.0 \
  --iou-weight 0.35 \
  --yaw-weight 0.08 \
  --score-weight 0.18 \
  --source-weight 0.12 \
  --position-alpha 0.85 \
  --velocity-alpha 0.70 \
  --confirmation-hits 1 \
  --confirmation-mode confirmed_only \
  --class-confirmation-hits "0:2" \
  --class-duplicate-birth-distances-m "0:0.45,1:0.90,2:0.75,3:0.90,4:0.75,5:0.65,6:0.85" \
  --duplicate-birth-iou 0.05 \
  --class-immediate-birth-scores "0:0.90" \
  --min-track-confidence 0.0 \
  --decimals 2 \
  --out "$RUN_DIR/track1_raw.txt"

python scripts/remap_submission_ids.py \
  --input "$RUN_DIR/track1_raw.txt" \
  --output "$RUN_DIR/track1.txt"
python -m physicalai_track1 validate --submission "$RUN_DIR/track1.txt" > "$RUN_DIR/submission_validate.json"
python scripts/audit_track1_submission.py "$RUN_DIR/track1.txt" > "$RUN_DIR/submission_audit.txt"
(cd "$RUN_DIR" && rm -f track1.zip && zip -j -q track1.zip track1.txt)

cat "$RUN_DIR/submission_validate.json"
cat "$RUN_DIR/submission_audit.txt"
ls -lh "$RUN_DIR/track1.txt" "$RUN_DIR/track1.zip"
echo "submission=$RUN_DIR/track1.zip"
date
