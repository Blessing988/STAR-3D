#!/bin/bash
#PBS -q preemptible
#PBS -N Track1_Depth_File
#PBS -l select=1:mem=32gb:ncpus=2
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
REPO_ID="${REPO_ID:-nvidia/PhysicalAI-SmartSpaces}"
LOCAL_DIR="${LOCAL_DIR:-/path/to/PhysicalAI-SmartSpaces}"
FILES="${FILES:?Set FILES to comma-separated repo-relative h5 paths}"
RETRIES="${RETRIES:-12}"
SLEEP_SECONDS="${SLEEP_SECONDS:-20}"

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true

export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"
export HF_HOME="${HF_HOME:-/path/to/hf_cache}"
if [[ -f /path/to/hf_tokens && -z "${HF_TOKEN:-}" ]]; then
  export HF_TOKEN="$(head -n 1 /path/to/hf_tokens)"
fi
if [[ -n "${HF_TOKEN:-}" ]]; then
  export HUGGING_FACE_HUB_TOKEN="$HF_TOKEN"
fi
mkdir -p "$HF_HOME" "$LOCAL_DIR"

echo "repo_id=$REPO_ID"
echo "local_dir=$LOCAL_DIR"
echo "files=$FILES"
echo "retries=$RETRIES"
echo "hf_home=$HF_HOME"
date

python scripts/download_depth_files.py \
  --repo-id "$REPO_ID" \
  --local-dir "$LOCAL_DIR" \
  --files "$FILES" \
  --workers 1 \
  --retries "$RETRIES" \
  --sleep-seconds "$SLEEP_SECONDS"

date
