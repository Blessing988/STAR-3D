#!/bin/bash
#PBS -q gpus
#PBS -N Track1_AdaptiveBirth_Val
#PBS -l select=1:mem=40gb:ncpus=4:ngpus=1
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATA_ROOT="${DATA_ROOT:-/path/to/PhysicalAI-SmartSpaces}"
FUSED="${FUSED:-$SCRATCH_ROOT/runs/inference/ensemble_yolo_dfine_val_692702.bright04/star/fused.tsv}"
RUN_ROOT="${RUN_ROOT:-$SCRATCH_ROOT/runs/sweeps/online_adaptive_birth_val_${PBS_JOBID:-manual}}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/sweeps}"
SCENES="${SCENES:-Warehouse_020 Warehouse_021 Warehouse_022}"
MAX_FRAMES="${MAX_FRAMES:-600}"
FRAME_STRIDE="${FRAME_STRIDE:-30}"
export RUN_ROOT

mkdir -p "$RUN_ROOT" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

date
hostname
echo "fused=$FUSED"
echo "run_root=$RUN_ROOT"

if [[ ! -s "$FUSED" ]]; then
  echo "Missing fused detections: $FUSED" >&2
  exit 2
fi

CLASS_SCORES="0:0.75,1:0.88,2:0.50,3:0.55,4:0.55,5:0.55,6:0.62"
CLASS_DISTANCES="0:1.45,1:2.35,2:2.00,3:2.40,4:2.10,5:1.85,6:2.30"
CLASS_COSTS="0:1.05,1:1.22,2:1.15,3:1.22,4:1.18,5:1.12,6:1.20"
CLASS_AGES="0:45,1:75,2:65,3:75,4:65,5:55,6:70"
DUP_DISTANCES="0:0.45,1:0.90,2:0.75,3:0.90,4:0.75,5:0.65,6:0.85"

run_variant() {
  local name="$1"
  local class_immediate_scores="$2"
  local immediate_min_sources="$3"
  local out_dir="$RUN_ROOT/$name"

  mkdir -p "$out_dir"
  echo "=== variant=$name"
  echo "class_immediate_scores=$class_immediate_scores immediate_min_sources=$immediate_min_sources"

  args=(python -m physicalai_track1 track-online
    --fused "$FUSED"
    --class-min-scores "$CLASS_SCORES"
    --min-score 0.0
    --max-cost 1.10
    --max-distance-m 1.60
    --max-age 45
    --class-max-distances-m "$CLASS_DISTANCES"
    --class-max-costs "$CLASS_COSTS"
    --class-max-ages "$CLASS_AGES"
    --distance-weight 1.0
    --iou-weight 0.35
    --yaw-weight 0.08
    --score-weight 0.18
    --source-weight 0.12
    --position-alpha 0.85
    --velocity-alpha 0.70
    --confirmation-hits 1
    --confirmation-mode confirmed_only
    --class-confirmation-hits "0:2"
    --class-duplicate-birth-distances-m "$DUP_DISTANCES"
    --duplicate-birth-iou 0.05
    --decimals 6
    --out "$out_dir/track1.txt")
  if [[ "$class_immediate_scores" != "none" ]]; then
    args+=(--class-immediate-birth-scores "$class_immediate_scores")
  fi
  if [[ "$immediate_min_sources" != "none" ]]; then
    args+=(--immediate-birth-min-sources "$immediate_min_sources")
  fi
  "${args[@]}" > "$out_dir/track.json"

  python -m physicalai_track1 validate --submission "$out_dir/track1.txt" > "$out_dir/validate.json"
  python -m physicalai_track1 eval \
    --data-root "$DATA_ROOT" \
    --year 2026 \
    --split val \
    --scenes $SCENES \
    --max-frames-per-scene "$MAX_FRAMES" \
    --frame-stride "$FRAME_STRIDE" \
    --pred "$out_dir/track1.txt" > "$out_dir/eval.json"
}

run_variant "adaptive_strict_person2" "none" "none"
run_variant "adaptive_score085" "0:0.85" "none"
run_variant "adaptive_score090" "0:0.90" "none"
run_variant "adaptive_score095" "0:0.95" "none"
run_variant "adaptive_sources2" "none" "2"
run_variant "adaptive_score090_sources2" "0:0.90" "2"

python - <<'PY'
import json
import os
from pathlib import Path

root = Path(os.environ["RUN_ROOT"])
rows = []
for path in sorted(root.glob("*/eval.json")):
    with path.open("r", encoding="utf-8") as f:
        metrics = json.load(f)
    rows.append((metrics.get("hota_like", 0.0), path.parent.name, metrics))
for score, name, metrics in sorted(rows, reverse=True):
    print(
        f"{name}\thota_like={metrics.get('hota_like', 0.0):.6f}"
        f"\tdeta={metrics.get('deta', 0.0):.6f}"
        f"\tassa={metrics.get('assa', 0.0):.6f}"
        f"\tloca={metrics.get('loca', 0.0):.6f}"
    )
PY

date
