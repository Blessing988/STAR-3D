#!/bin/bash
#PBS -q gpus
#PBS -N Track1_DFINE_STAR_Val
#PBS -l select=1:mem=120gb:ncpus=16:ngpus=1
#PBS -l walltime=24:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
DFINE_ROOT="${DFINE_ROOT:-$PROJECT_ROOT/D-FINE}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/dfine}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATASET_DIR="${DATASET_DIR:-$SCRATCH_ROOT/datasets/yolo_2026_stride30}"
IMAGE_DIR="${IMAGE_DIR:-$DATASET_DIR/images/val}"
MANIFEST="${MANIFEST:-$DATASET_DIR/val_frames.tsv}"
CONFIG="${CONFIG:-$DFINE_ROOT/configs/dfine/custom/track1_dfine_hgnetv2_l_960_class_balanced.yml}"
CHECKPOINT="${CHECKPOINT:-$SCRATCH_ROOT/runs/dfine/dfine_l_960_class_balanced_168h_fixed/best_stg1.pth}"
INPUT_SIZE="${INPUT_SIZE:-960}"
CONF="${CONF:-0.01}"
IOU="${IOU:-0.70}"
BATCH="${BATCH:-8}"
SCENES="${SCENES:-Warehouse_020 Warehouse_021 Warehouse_022}"
MAX_FRAMES="${MAX_FRAMES:-600}"
FRAME_STRIDE="${FRAME_STRIDE:-30}"
RUN_NAME="${RUN_NAME:-dfine_l_star_val_${PBS_JOBID:-manual}}"
RUN_DIR="${RUN_DIR:-$SCRATCH_ROOT/runs/inference/$RUN_NAME}"
LOG_DIR="${LOG_DIR:-$SCRATCH_ROOT/logs/inference}"

bind_pbs_gpu() {
  if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
    return 0
  fi
  if [[ -z "${PBS_GPUFILE:-}" || ! -f "$PBS_GPUFILE" ]]; then
    return 0
  fi
  local line token
  line="$(head -1 "$PBS_GPUFILE")"
  token="${line##*gpu}"
  if [[ ! "$token" =~ ^[0-9]+$ ]]; then
    token="${line##*nvidia}"
  fi
  if [[ ! "$token" =~ ^[0-9]+$ ]]; then
    token="${line##*[-:[:space:]]}"
  fi
  if [[ "$token" =~ ^[0-9]+$ ]]; then
    export CUDA_VISIBLE_DEVICES="$token"
  fi
}

mkdir -p "$RUN_DIR" "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/${PBS_JOBNAME}.${PBS_JOBID}.log") 2>&1

cd "$DFINE_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"
bind_pbs_gpu

date
hostname
echo "cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-unset}"
echo "checkpoint=$CHECKPOINT"
echo "run_dir=$RUN_DIR"
nvidia-smi || true

python -m physicalai_track1 infer-dfine-manifest \
  --dfine-root "$DFINE_ROOT" \
  --config "$CONFIG" \
  --checkpoint "$CHECKPOINT" \
  --manifest "$MANIFEST" \
  --images-root "$IMAGE_DIR" \
  --input-size "$INPUT_SIZE" \
  --confidence "$CONF" \
  --nms-iou "$IOU" \
  --batch-size "$BATCH" \
  --device cuda:0 \
  --scenes $SCENES \
  --max-frame-id "$((MAX_FRAMES - 1))" \
  --out "$RUN_DIR/detections.tsv"

cd "$PROJECT_ROOT"
DETECTIONS="$RUN_DIR/detections.tsv" \
RUN_DIR="$RUN_DIR/star" \
SCENES="$SCENES" \
MAX_FRAMES="$MAX_FRAMES" \
FRAME_STRIDE="$FRAME_STRIDE" \
bash scripts/run_star_geometry_val.sh

date
