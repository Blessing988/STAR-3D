#!/bin/bash
#PBS -q gpus
#PBS -N Track1_YOLO_H100
#PBS -l select=1:mem=320gb:ncpus=32:ngpus=1:host=gpu0061
#PBS -l walltime=168:00:00
#PBS -W group_list=x-ccast-prj-your-group
#PBS -M your.email@example.com
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/PhysicalAI_Track1}"
CONDA_ENV="${CONDA_ENV:-/path/to/conda_envs/physicalai_track1_detector}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/path/to/scratch/PhysicalAI_Track1}"
DATA_YAML="${DATA_YAML:-$SCRATCH_ROOT/datasets/yolo_2026_stride30/aicity_track1_2026.yaml}"
MODEL="${MODEL:-yolo26x.pt}"
IMGSZ="${IMGSZ:-1536}"
EPOCHS="${EPOCHS:-80}"
BATCH="${BATCH:--1}"
RUN_NAME="${RUN_NAME:-yolo26x_1536_h100_stride30_aug}"
RUNS_ROOT="${RUNS_ROOT:-$SCRATCH_ROOT/runs/detector}"
PATIENCE="${PATIENCE:-20}"
SAVE_PERIOD="${SAVE_PERIOD:-10}"
CLOSE_MOSAIC="${CLOSE_MOSAIC:-15}"
WORKERS="${WORKERS:-16}"
DEVICES="${DEVICES:-0}"

bind_pbs_gpus() {
  if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
    return 0
  fi
  if [[ -z "${PBS_GPUFILE:-}" || ! -f "$PBS_GPUFILE" ]]; then
    return 0
  fi

  local ids
  ids="$(
    while IFS= read -r line; do
      local token
      token="${line##*gpu}"
      if [[ "$token" =~ ^[0-9]+$ ]]; then
        echo "$token"
        continue
      fi
      token="${line##*nvidia}"
      if [[ "$token" =~ ^[0-9]+$ ]]; then
        echo "$token"
        continue
      fi
      token="${line##*[-:[:space:]]}"
      if [[ "$token" =~ ^[0-9]+$ ]]; then
        echo "$token"
      fi
    done < "$PBS_GPUFILE" | paste -sd, -
  )"

  if [[ -n "$ids" ]]; then
    export CUDA_VISIBLE_DEVICES="$ids"
  fi
}

cd "$PROJECT_ROOT"
source /mmfs1/apps/pyenvs/anaconda3-2022.05/bin/activate base || true
source activate "$CONDA_ENV"
export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"

bind_pbs_gpus
echo "PBS_GPUFILE=${PBS_GPUFILE:-unset}"
if [[ -n "${PBS_GPUFILE:-}" && -f "$PBS_GPUFILE" ]]; then
  cat "$PBS_GPUFILE"
fi
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi || true

yolo detect train \
  model="$MODEL" \
  data="$DATA_YAML" \
  imgsz="$IMGSZ" \
  epochs="$EPOCHS" \
  batch="$BATCH" \
  device="$DEVICES" \
  workers="$WORKERS" \
  project="$RUNS_ROOT" \
  name="$RUN_NAME" \
  exist_ok=True \
  pretrained=True \
  optimizer=auto \
  cos_lr=True \
  patience="$PATIENCE" \
  save_period="$SAVE_PERIOD" \
  close_mosaic="$CLOSE_MOSAIC" \
  hsv_h=0.015 \
  hsv_s=0.55 \
  hsv_v=0.45 \
  translate=0.08 \
  scale=0.55 \
  perspective=0.0005 \
  fliplr=0.5 \
  mosaic=1.0 \
  mixup=0.08 \
  copy_paste=0.15 \
  erasing=0.35
